# Direct Cost Master API Server Configuration
# Copy this file to .env and update with your settings

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-make-it-long-and-random
JWT_EXPIRE_HOURS=24

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/directcostmaster

# Temporary File Storage
TEMP_FILE_DIR=./temp_files
TEMP_EXPORT_DIR=./temp_exports

# File Upload Limits
MAX_UPLOAD_SIZE=50000000  # 50MB
MAX_FILES_PER_UPLOAD=20

# Session/Token Configuration
SESSION_DURATION_HOURS=24

# CORS Configuration (for frontend)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Logging Configuration
LOG_LEVEL=INFO

# Background Task Configuration
CLEANUP_INTERVAL_HOURS=6  # How often to clean temp files
FILE_RETENTION_HOURS=24   # How long to keep uploaded files
EXPORT_RETENTION_HOURS=1  # How long to keep export files
JOB_RETENTION_HOURS=48    # How long to keep job status
